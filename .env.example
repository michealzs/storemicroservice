# --- App ---
APP_NAME="AI Commerce Service"
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Database (Postgres + pgvector) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app

# --- LLM provider (openai | anthropic). Leave keys blank to run keyless. ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- Payments (optional) ---
STRIPE_SECRET_KEY=

# --- Vector store (pgvector | weaviate | pinecone) ---
VECTOR_BACKEND=pgvector
VECTOR_COLLECTION=product_catalog

# Weaviate (optional)
WEAVIATE_URL=
WEAVIATE_API_KEY=

# Pinecone (optional)
PINECONE_API_KEY=
PINECONE_INDEX=product-catalog
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Observability ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai-commerce
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
